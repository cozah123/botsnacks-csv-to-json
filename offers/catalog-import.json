{
  "name": "Find price changes after a catalog import",
  "question": "Did any prices change during my catalog import?",
  "buyer": "A catalog agent verifying one completed supplier-feed import before publication",
  "endpoint": "https://botsnacks-testnet-api.cozah.chatgpt.site/api/v1/verify-transform",
  "method": "POST",
  "protocol": "x402",
  "network": "eip155:84532",
  "testnet_only": true,
  "price": {"binding_source": "unsigned POST for the exact batch", "schedule_url": "https://botsnacks-testnet-api.cozah.chatgpt.site/.well-known/x402", "minimum": "0.01", "maximum": "0.05", "currency": "test USDC", "unit": "completed eligible comparison"},
  "inputs": {"key": "sku", "fields": {"price": "decimal", "currency": "exact"}, "scope": "Same catalog revision, variants, price basis and units in both exports."},
  "buyer_pilot": {
    "scope": "Separate synthetic two-order sample",
    "guide_url": "https://github.com/cozah123/botsnacks-csv-to-json/tree/df151bdb8658b6704f8d7736df4d84f6b8630022/integrations/agentprocure",
    "working_directory": "integrations/agentprocure",
    "runtime": "Node.js 24 or newer",
    "install_command": "npm ci --ignore-scripts",
    "quote_command": "node pilot.mjs quote",
    "wallet_required_for_quote": false,
    "quote_cost_test_usdc": "0.00",
    "purchase_price_test_usdc": "0.01",
    "network": "eip155:84532",
    "lucid_quote": {
      "guide_url": "https://github.com/cozah123/botsnacks-csv-to-json/blob/main/README.md#test-your-agents-checkout",
      "working_directory": "integrations/lucid-agents",
      "tested_runtime": "Bun 1.3.13",
      "package": "@lucid-agents/payments@2.5.0",
      "install_command": "bun install --frozen-lockfile --ignore-scripts",
      "quote_command": "bun run quote.mjs",
      "wallet_required": false,
      "signs_or_pays": false
    }
  },
  "free_quote": "POST job and a private request_key with no payment signature. An eligible request returns HTTP 402 with the terms. Prefix keys for synthetic examples with bs_qa_.",
  "practice_command": "python3 scripts/catalog.py practice",
  "practice_clean_command": "python3 scripts/catalog.py practice --clean",
  "practice_exit_codes": {"0": "pass", "1": "hold", "2": "no_verdict"},
  "store_catalog_exporter": {
    "source": "Shopify products JSON from the same export scope",
    "target": "Store Catalog Exporter variants.csv",
    "matched_by": "variant ID",
    "compared_fields": ["sku", "price"],
    "question": "Did any prices or SKUs change during my Shopify export?",
    "placement": "Add the step to the job that produces variants.csv, after a successful export and only for batches the operator permits sending to BotSnacks. Replace both example paths with files from that same export.",
    "github_actions_step": {
      "name": "Quote this Shopify export",
      "id": "botsnacks_quote",
      "uses": "cozah123/botsnacks-csv-to-json/integrations/store-catalog-exporter@4a8d5561b4bfe0af133ec96219bf08920216adac",
      "with": {
        "source": "supplier-feed.json",
        "variants": "exports/demo/variants.csv"
      }
    },
    "fields_sent": [
      "id",
      "sku",
      "price"
    ],
    "wallet_required_for_quote": false,
    "quote_cost_test_usdc": "0.00",
    "purchase_guide": "https://github.com/cozah123/botsnacks-csv-to-json/blob/main/integrations/store-catalog-exporter/README.md",
    "job_mapping": {
      "key": {"source": "id", "target": "id"},
      "fields": [{"source": "sku", "target": "sku", "type": "exact"}, {"source": "price", "target": "price", "type": "decimal"}]
    },
    "two_export_pilot": {
      "entry_point": "integrations/store-catalog-exporter/on_export.py",
      "guide": "https://github.com/cozah123/botsnacks-csv-to-json/blob/main/integrations/store-catalog-exporter/README.md#run-a-two-export-pilot",
      "trigger": "after each completed export on a buyer-owned persistent POSIX worker",
      "default_mode": "offline_prepare",
      "max_distinct_comparisons": 2,
      "requires_buyer_policy_for_payment": true
    },
    "checkout_module": "scripts/comparison.mjs",
    "decision_module": "integrations/store-catalog-exporter/decision.mjs",
    "decisions": ["pass", "hold", "needs_review"],
    "prepare_command": "python3 scripts/catalog.py prepare-store-export supplier-feed.json exports/demo/variants.csv /private/batch/request.json"
  },
  "job_quote_command": "python3 scripts/catalog.py quote /private/batch/request.json",
  "example_command": "python3 scripts/catalog.py quote-example",
  "example_job": {
    "source": {"format": "csv", "data": "sku,price,currency\nSKU-001,19.99,USD\nSKU-002,8.50,USD\nSKU-003,14.00,EUR\n"},
    "target": {"format": "json", "data": [
      {"sku": "SKU-003", "price": "14", "currency": "EUR"},
      {"sku": "SKU-001", "price": "199.90", "currency": "USD"},
      {"sku": "SKU-002", "price": "8.5", "currency": "USD"}
    ]},
    "key": {"source": "sku", "target": "sku"},
    "fields": [{"source": "price", "target": "price", "type": "decimal"}, {"source": "currency", "target": "currency", "type": "exact"}]
  },
  "expected_example": {"source_rows": 3, "target_rows": 3, "missing_rows": 0, "unexpected_rows": 0, "changed_values": 1, "issue": {"code": "changed_value", "key": "SKU-001", "source_field": "price", "source_value": "19.99", "target_value": "199.90"}},
  "retrieval": "Read the saved report again, or recover using the identical request and original payment authorization.",
  "instructions": "https://github.com/cozah123/botsnacks-csv-to-json/blob/main/SKILL.md#check-prices-after-a-catalog-import"
}
