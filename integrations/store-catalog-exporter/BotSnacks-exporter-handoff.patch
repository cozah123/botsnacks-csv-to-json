@@ -40,6 +40,30 @@ def fixture_product():
     return copy.deepcopy(read_json(ROOT / "examples/sample-feed.json")["products"][0])
 
 
+class ComparisonOfferTests(unittest.TestCase):
+    def test_completed_snapshot_offer_is_local_and_opt_in(self):
+        source = ROOT / "examples/sample-feed.json"
+        with tempfile.TemporaryDirectory() as folder:
+            output = Path(folder) / "out"
+            def run(snapshot, *extras):
+                stdout = io.StringIO()
+                with contextlib.redirect_stdout(stdout):
+                    code = main(["convert", str(snapshot), "--source", SOURCE, "--output", str(output), *extras])
+                return code, json.loads(stdout.getvalue())
+            self.assertNotIn("comparison_offer", run(source)[1])
+            code, result = run(source, "--comparison-offer")
+            self.assertEqual(code, 0)
+            self.assertEqual(Path(result["comparison_offer"]["products"]), source)
+            self.assertEqual(Path(result["comparison_offer"]["variants"]), output / "variants.csv")
+            self.assertNotIn("comparison_offer", run(output / "bundle.json", "--comparison-offer")[1])
+            array = Path(folder) / "array.json"
+            array.write_text(json.dumps(read_json(source)["products"]), encoding="utf-8")
+            self.assertNotIn("comparison_offer", run(array, "--comparison-offer")[1])
+            code, result = run(source, "--comparison-offer", "--max-products", "1")
+            self.assertEqual(code, 2)
+            self.assertNotIn("comparison_offer", result)
+
+
